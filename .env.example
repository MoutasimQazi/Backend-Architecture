# Copy to .env and fill in. Never commit .env.

APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=INFO

# --- Database (cPanel MySQL) ------------------------------------------------
DB_HOST=213.136.64.26
DB_PORT=3306
DB_USER=movenetics_fitness
DB_PASSWORD=
DB_NAME=movenetics_fitness
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# Keep below the server's wait_timeout so pooled sockets are recycled first.
DB_POOL_RECYCLE=280

# --- Security ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_AUDIENCE=fitness-api

# Dev only: trust X-User-Id instead of a bearer token. Must stay false in
# production — it lets any caller claim any user id.
ALLOW_HEADER_AUTH=false

# Comma-separated. Do not leave as * in production.
CORS_ORIGINS=*

RATE_LIMIT_PER_MIN=30
RATE_LIMIT_PER_DAY=500

# --- Models -----------------------------------------------------------------
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
HF_TOKEN=

# Which provider answers first; the rest are fallbacks used only when the one
# before them fails or its circuit breaker opens. A key that is set but not
# listed is still appended as a fallback, so a typo here degrades rather than
# taking the provider offline.
PROVIDER_ORDER=deepseek,openai,huggingface

# SMALL = routing, classification, extraction (latency-critical, high volume).
# LARGE = final synthesis and explanation only.
# These two name OPENAI models and are used only when the call lands on OpenAI.
SMALL_MODEL=gpt-4o-mini
LARGE_MODEL=gpt-4o

# Per-provider equivalents. Each provider serves its own model names, so the
# small/large split has to be declared once per provider or it collapses on
# failover.
#
# DeepSeek runs deepseek-v4-flash for BOTH classes. deepseek-chat and
# deepseek-reasoner were retired from the account; deepseek-v4-pro is blocked
# in providers.py and cannot be selected from here.
#
# flash is a reasoning model: it spends completion tokens on hidden reasoning
# before emitting any content, and DeepSeek bills those as output tokens.
# Measured worst case on a router prompt is ~288 completion tokens for a
# ~30-token answer. providers.py adds reasoning headroom to every budget, so
# the max_tokens set on each chain still describes the reply you want.
# flash: 1M context, 384K max output, $0.14/$0.28 per 1M in/out, and
# $0.0028 per 1M for input served from DeepSeek's prompt cache. Cache
# hits are priced separately in providers.py - the repeated system
# prompt makes them the normal case, worth ~60% of input spend.
DEEPSEEK_SMALL_MODEL=deepseek-v4-flash
DEEPSEEK_LARGE_MODEL=deepseek-v4-flash
HF_SMALL_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_LARGE_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Embeddings are OFF by default and nothing external is called for them.
# Retrieval is lexical: InnoDB FULLTEXT for FAQ, and the resolver's
# exact/CAS/synonym/OCR-variant/edit-distance ladder for ingredients.
#
# The golden sets pass without embeddings (router 25/26 vs an 85% gate,
# faq_retrieval 10/11 vs 80%), so this costs nothing measurable. Set
# EMBEDDING_PROVIDER=openai only if you later want paraphrase matching, and
# note the OpenAI project must actually be entitled to the embedding model —
# a chat-only project returns 403 model_not_found on every call.
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- Versions (bumping either invalidates the caches that used them) --------
PROMPT_VERSION=v1
KB_VERSION=v1

# --- Cache ------------------------------------------------------------------
CACHE_ENABLED=true
CACHE_L1_MAX_ENTRIES=1024
CACHE_SEMANTIC_THRESHOLD=0.93

# --- Router thresholds (tune per category against the eval set) -------------
ROUTER_TAU_FAQ=0.82
ROUTER_TAU_FAQ_MEDICAL=0.90
ROUTER_TAU_FAQ_APPSUPPORT=0.74
ROUTER_TAU_CACHE=0.93

# --- Jobs -------------------------------------------------------------------
JOB_POLL_INTERVAL=3
JOB_BATCH_SIZE=5
JOB_MAX_ATTEMPTS=3
JOB_LEASE_SECONDS=600
# Non-zero makes a long-running worker exit after N seconds, for hosts that
# kill long processes anyway. 0 = run until stopped.
JOB_MAX_RUNTIME_SECONDS=0

# --- Storage ----------------------------------------------------------------
# Keep this OUTSIDE public_html.
BLOB_DIR=./var/blobs
MAX_UPLOAD_BYTES=8388608
MAX_ATTACHMENTS=5

# --- Outbound fetch broker --------------------------------------------------
FETCH_TIMEOUT=20
FETCH_MAX_BYTES=5242880

# --- OCR (existing service) -------------------------------------------------
OCR_API_URL=https://ocr.moveneticsdigital.com/
OCR_API_KEY=
OCR_LANG=en
