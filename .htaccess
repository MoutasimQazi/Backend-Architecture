# Apache protection for a Passenger app whose root sits inside public_html.
#
# cPanel's "Application root" for this app is
#   public_html/fitness.moveneticsdigital.com
# so every file in the repo is reachable over HTTP unless Passenger intercepts
# the request first. Passenger only handles routes the app claims; a direct hit
# on a real file on disk can still be served by Apache.
#
# Without these rules the following are fetchable by anyone:
#   /.env                                    DB password, JWT secret, API keys
#   /packages/storage/migrations/001_init.sql  the whole schema
#   /var/blobs/ab/cd/<hash>.jpg              other users' uploaded health documents
#
# Moving the app root outside public_html is the better fix. These rules are
# the belt-and-braces for when it stays where it is.

# --- secrets and config ----------------------------------------------------
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

<FilesMatch "\.(env|ini|cfg|sqlite3|db|log|bak|sql|pem|key)$">
    Require all denied
</FilesMatch>

<Files ".htaccess">
    Require all denied
</Files>

<Files "passenger_wsgi.py">
    Require all denied
</Files>

# --- source code -----------------------------------------------------------
# Nothing under these should ever be served as a file. Passenger runs the app;
# Apache has no business handing out the source.
RedirectMatch 404 ^/(packages|apps|scripts|var|jobs|\.git|__pycache__)(/|$)

<FilesMatch "\.(py|pyc|pyo|md|txt|toml|lock)$">
    Require all denied
</FilesMatch>

# requirements.txt and README.md are covered above; re-allow nothing.

# --- uploaded blobs --------------------------------------------------------
# Belt-and-braces only: BLOB_DIR should point outside public_html entirely.
<IfModule mod_authz_core.c>
    <Directory "var">
        Require all denied
    </Directory>
</IfModule>

# --- directory listing -----------------------------------------------------
Options -Indexes

# --- transport -------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"
    # The API is JSON only; there is no HTML surface to protect with CSP beyond this.
    Header always set Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Force HTTPS: JWTs and health data must never travel in clear.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>
