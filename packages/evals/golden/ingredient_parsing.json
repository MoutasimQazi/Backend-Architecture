[
  {
    "id": "simple_panel",
    "panel": "Ingredients: Aqua, Glycerin, Phenoxyethanol.",
    "expect_tokens": ["Aqua", "Glycerin", "Phenoxyethanol"]
  },
  {
    "id": "nested_parenthetical",
    "note": "the comma inside brackets must not split the token",
    "panel": "Ingredients: CI 77491 (Iron Oxides, Titanium Dioxide), Aqua",
    "expect_tokens": ["CI 77491", "Aqua"]
  },
  {
    "id": "percentages_stripped",
    "panel": "Ingredients: Aqua 60%, Glycerin 5%, Niacinamide 10%",
    "expect_tokens": ["Aqua", "Glycerin", "Niacinamide"]
  },
  {
    "id": "numbering_stripped",
    "panel": "Ingredients: 1. Aqua, 2. Glycerin, 3. Parfum",
    "expect_tokens": ["Aqua", "Glycerin", "Parfum"]
  },
  {
    "id": "duplicates_removed_order_kept",
    "note": "INCI order carries concentration meaning, so order must survive dedupe",
    "panel": "Ingredients: Aqua, Glycerin, Aqua, Parfum",
    "expect_tokens": ["Aqua", "Glycerin", "Parfum"]
  },
  {
    "id": "traces_separated",
    "panel": "Ingredients: Wheat Flour, Sugar. May contain traces of Peanuts, Milk",
    "expect_tokens": ["Wheat Flour", "Sugar", "Peanuts", "Milk"],
    "expect_traces": ["Peanuts", "Milk"]
  },
  {
    "id": "boilerplate_dropped",
    "panel": "Ingredients: Aqua, Glycerin, and other ingredients, list subject to change",
    "expect_tokens": ["Aqua", "Glycerin"]
  },
  {
    "id": "bare_digits_dropped",
    "panel": "Ingredients: Aqua, 12345, Glycerin",
    "expect_tokens": ["Aqua", "Glycerin"]
  },
  {
    "id": "qualifier_retained",
    "note": "the common name in brackets is a resolver fallback, not noise",
    "panel": "Ingredients: Tocopherol (Vitamin E), Aqua",
    "expect_tokens": ["Tocopherol", "Aqua"],
    "expect_qualifiers": {"Tocopherol": ["Vitamin E"]}
  },
  {
    "id": "empty_panel",
    "panel": "",
    "expect_tokens": []
  },
  {
    "id": "semicolon_separated",
    "panel": "Ingredients: Aqua; Glycerin; Parfum",
    "expect_tokens": ["Aqua", "Glycerin", "Parfum"]
  }
]
